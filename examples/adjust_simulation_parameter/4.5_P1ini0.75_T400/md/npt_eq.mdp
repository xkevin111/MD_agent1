; npt_eq.mdp - 50 ns NPT Equilibration
integrator              = md
nsteps                  = 50000000       ; 50 ns with 1 fs time step
dt                      = 0.001         ; 1 fs time step [cite: 5]

; Output control
nstxout                 = 10000         ; save coordinates every 10.0 ps [cite: 6]
nstvout                 = 10000         ; save velocities every 10.0 ps [cite: 7]
nstenergy               = 10000         ; save energies every 10.0 ps [cite: 8]
nstlog                  = 10000         ; update log file every 10.0 ps [cite: 9]

; Bond parameters
continuation            = no            ; First MD step
constraint_algorithm    = lincs         ; holonomic constraints [cite: 11]
constraints             = all-bonds     ; all bonds are constrained [cite: 12]
lincs_iter              = 1             ; accuracy of LINCS [cite: 13]
lincs_order             = 4             ; 4th order [cite: 14]

; Nonbonded settings
cutoff-scheme           = Verlet        ; Buffered neighbor searching [cite: 15]
ns_type                 = grid          ; search neighboring grid cells [cite: 16]
nstlist                 = 10
rcoulomb                = 1.2           ; short-range electrostatic cutoff (in nm) [cite: 18]
rvdw                    = 1.2           ; short-range van der Waals cutoff (in nm) [cite: 19]
DispCorr                = EnerPres      ; account for cut-off vdW scheme [cite: 20]

; Add a static electric field along the -x axis
; Format: electric-field-x = E0 omega t0 sigma
; electric-field-x = -0.5 0 0 0

; Electrostatics
coulombtype             = PME           ; Particle Mesh Ewald for long-range electrostatics [cite: 21]
pme_order               = 4             ; 4th order cubic interpolation [cite: 22]
fourierspacing          = 0.25          ; grid spacing for FFT [cite: 23]

; Temperature coupling (V-rescale for Equilibration)
tcoupl                  = V-rescale     ; Modified Berendsen thermostat
tc-grps                 = System        ; target group of tcoupl [cite: 24]
tau_t                   = 0.1           ; time constant, in ps
ref_t                   = 400           ; target temp 

; Pressure coupling
pcoupl                  = C-rescale     ; pressure coupling [cite: 27]
pcoupltype              = isotropic     ; uniform scaling of box vectors [cite: 28]
tau_p                   = 5.0           ; time constant, in ps [cite: 29]
ref_p                   = 1.0           ; reference pressure, in bar [cite: 30]
compressibility         = 4.5e-5        ; isothermal compressibility of water, bar^-1 [cite: 31]
refcoord_scaling        = com

; Periodic boundary conditions
pbc                     = xyz           ; 3-D PBC [cite: 33]

; Velocity generation
gen_vel                 = no            ; Velocity generation is off (continued from equilibration) [cite: 34]